{
  "expo": {
    "name": "lucky prism",
    "slug": "lucky-prisme",
    "scheme": "luckyprism",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lucky-prism-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/lucky-prism-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15151a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/lucky-prism-icon.png",
        "backgroundColor": "#15151a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kicikici.luckyprisme"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a50dd61-3675-4b83-a325-4049c08ef47f"
      }
    }
  }
}
